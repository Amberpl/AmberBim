<ui:FluentWindow x:Class="AmberBim.UiGallery.GalleryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AmberBIM UI Gallery" Width="720" Height="420"
                 MinWidth="600" MinHeight="360"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="AmberBIM UI Gallery" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="24,16,24,24">
            <TextBlock Text="Makiety okien" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Wybierz wariant i otwórz podgląd." Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Variants" SelectedIndex="1"
                     SelectionChanged="SelectVariant" MouseDoubleClick="OpenSelectedVariant"
                     VerticalAlignment="Top" AutomationProperties.Name="Okna i warianty">
                <ListBoxItem Content="Info · obecne" Padding="12" />
                <ListBoxItem Content="Info · kompaktowe" Padding="12" />
                <ListBoxItem Content="Eksport zestawień" Padding="12" />
            </ListBox>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="VariantTitle" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VariantDescription" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Content="Otwórz podgląd" Appearance="Primary" Click="OpenPreview"
                           HorizontalAlignment="Left" Margin="0,24,0,0" />
                <TextBlock Text="Po zamknięciu okna wrócisz do galerii."
                           Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
