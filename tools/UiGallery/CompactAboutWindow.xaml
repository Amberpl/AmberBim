<ui:FluentWindow x:Class="AmberBim.UiGallery.CompactAboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="O AmberBIM" Width="380" MinWidth="380" MinHeight="0" SizeToContent="Height"
                 ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False" PreviewKeyDown="HandlePreviewKeyDown"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="O AmberBIM" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="20,12,20,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Info24" FontSize="28" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="AmberBIM Tools" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Mateusz Amber Ambrożewicz" FontSize="14" Margin="0,16,0,0" />
            <TextBlock x:Name="CopyrightText" FontSize="12" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="14" VerticalAlignment="Bottom">
                    <Hyperlink NavigateUri="https://amberbim.wordpress.com" RequestNavigate="OpenWebsite">
                        amberbim.wordpress.com
                    </Hyperlink>
                </TextBlock>
                <ui:Button x:Name="CloseButton" Grid.Column="2" Content="Zamknij" Appearance="Secondary"
                           IsCancel="True" IsDefault="True" Click="CloseWindow"
                           VerticalAlignment="Bottom" MinWidth="88" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
