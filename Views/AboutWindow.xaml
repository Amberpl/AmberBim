<ui:FluentWindow x:Class="AmberBim.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="O AmberBIM"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 PreviewKeyDown="HandlePreviewKeyDown"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="O AmberBIM" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="28,16,28,28">
            <ui:SymbolIcon Symbol="Info24" FontSize="40" HorizontalAlignment="Left"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="AmberBIM Tools" FontSize="26" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock x:Name="VersionText" FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Separator Margin="0,22,0,18" />
            <TextBlock x:Name="CopyrightText" FontSize="14" />
            <TextBlock Text="Mateusz Amber Ambrożewicz" FontSize="14" Margin="0,6,0,16" />
            <TextBlock FontSize="14">
                <Hyperlink NavigateUri="https://amberbim.wordpress.com" RequestNavigate="OpenWebsite">
                    amberbim.wordpress.com
                </Hyperlink>
            </TextBlock>
            <ui:Button x:Name="CloseButton" Content="Zamknij" Appearance="Secondary"
                       IsCancel="True" IsDefault="True" Click="CloseWindow"
                       HorizontalAlignment="Right" MinWidth="104" Margin="0,28,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
