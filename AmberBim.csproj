<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>AmberBim</RootNamespace>
    <AssemblyName>AmberBim</AssemblyName>
    <Version>0.3.0</Version>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release;Debug2021;Release2021;Debug2022;Release2022;Debug2023;Release2023;Debug2024;Release2024;Debug2025;Release2025;Debug2026;Release2026;Debug2027;Release2027</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;.tools\**;.axe\**</DefaultItemExcludes>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>bin\Revit$(RevitVersion)\$(Configuration)\</OutputPath>
    <RevitApiPath Condition="'$(RevitApiPath)' == ''">$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitApiPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <Optimize Condition="$(Configuration.StartsWith('Release'))">true</Optimize>
    <DefineConstants Condition="$(Configuration.StartsWith('Debug'))">$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DefineConstants>$(DefineConstants);TRACE;REVIT_$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' &lt;= '2023'">$(DefineConstants);REVIT_LEGACY_REBAR_SOLID</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Resource Include="Ico\*.png" />
    <None Update="AmberBim.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Configuration" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' &gt;= '2024'">
    <Compile Remove="Rebar\RebarSolidInView.cs;Rebar\RebarNotSolidInView.cs" />
  </ItemGroup>

  <Target Name="ArrangeReleaseFiles" AfterTargets="CopyFilesToOutputDirectory"
          Condition="$(Configuration.StartsWith('Release')) and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ReleaseSupportFile Include="$(TargetDir)**\*"
                          Exclude="$(TargetPath);$(TargetDir)AmberBim.addin;$(TargetDir)AmberBIM\**\*" />
    </ItemGroup>
    <Move SourceFiles="@(ReleaseSupportFile)"
          DestinationFiles="@(ReleaseSupportFile->'$(TargetDir)AmberBIM\%(RecursiveDir)%(Filename)%(Extension)')">
      <Output TaskParameter="MovedFiles" ItemName="FileWrites" />
    </Move>
  </Target>

  <Target Name="ValidateRevitBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RevitVersion)', '^202[1-7]$'))"
           Text="Unsupported RevitVersion '$(RevitVersion)'. Choose a version from 2021 to 2027." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Configuration)', '^(Debug|Release)(202[1-7])?$'))"
           Text="Unsupported Configuration '$(Configuration)'. Use Debug2021 through Release2027, or Debug/Release with RevitVersion." />
    <Error Condition="'$(ConfigurationRevitVersion)' != '' and '$(ConfigurationRevitVersion)' != '$(RevitVersion)'"
           Text="Configuration $(Configuration) conflicts with RevitVersion $(RevitVersion)." />
    <Error Condition="'$(RevitUseNet10)' != 'true' and '$(RevitUseNet10)' != 'false'"
           Text="RevitUseNet10 must be true or false." />
    <Error Condition="'$(RevitUseNet10)' == 'true' and '$(RevitVersion)' &lt;= '2024'"
           Text="RevitUseNet10 is only supported for Revit 2025 and later." />
    <Error Condition="'$(TargetFramework)' != '$(RevitTargetFramework)'"
           Text="Revit $(RevitVersion) requires TargetFramework=$(RevitTargetFramework) for the selected build. Use RevitUseNet10=true for updated Revit 2025/2026 hosts." />
    <Error Condition="'$(PlatformTarget)' != 'x64'"
           Text="Revit builds require PlatformTarget=x64." />
    <Error Condition="!Exists('$(RevitApiPath)\RevitAPI.dll') or !Exists('$(RevitApiPath)\RevitAPIUI.dll')"
           Text="Revit $(RevitVersion) API assemblies not found in '$(RevitApiPath)'. Install that Revit version or set RevitApiPath to its API directory (RevitAPI.dll and RevitAPIUI.dll)." />
    <GetAssemblyIdentity AssemblyFiles="$(RevitApiPath)\RevitAPI.dll;$(RevitApiPath)\RevitAPIUI.dll">
      <Output TaskParameter="Assemblies" ItemName="RevitApiIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="!$([System.String]::Copy('%(RevitApiIdentity.Version)').StartsWith('$(RevitApiMajorVersion).'))"
           Text="%(RevitApiIdentity.Name) %(RevitApiIdentity.Version) does not match Revit $(RevitVersion). Set RevitApiPath to the matching API directory." />
  </Target>
</Project>
